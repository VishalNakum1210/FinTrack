{
  "rules": {
    ".read": false,
    ".write": false,
    "user_details": {
      "$phoneNumber": {
        ".read": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        ".write": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        ".validate": "!newData.exists() || (newData.hasChildren(['phone_number', 'email', 'name']) && newData.child('phone_number').val().length == 10)",
        "phone_number": {
          ".validate": "newData.isString() && newData.val().length == 10"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "address": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      }
    },
    "Expenses": {
      "$phoneNumber": {
        ".read": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        ".write": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        "$recordKey": {
          ".validate": "!newData.exists() || newData.hasChildren(['Amount', 'Category', 'Date', 'Payment_Mode'])",
          "Amount": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "Category": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "Description": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
          },
          "Date": {
            ".validate": "newData.isString()"
          },
          "Payment_Mode": {
            ".validate": "newData.isString()"
          }
        }
      }
    },
    "Friends": {
      "$phoneNumber": {
        ".read": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        ".write": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        "$friendNumber": {
          "friend_name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "friend_number": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "total_get": {
            ".validate": "newData.isString()"
          },
          "total_give": {
            ".validate": "newData.isString()"
          },
          "Records": {
            "$recordKey": {
              ".validate": "!newData.exists() || newData.hasChildren(['Amount', 'Type', 'Date'])"
            }
          }
        }
      }
    },
    "userUpdates": {
      "$phoneNumber": {
        ".read": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')",
        ".write": "auth != null && auth.token.email == ($phoneNumber + '@fintrack.app')"
      }
    }
  }
}

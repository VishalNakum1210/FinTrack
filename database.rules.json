{
  "rules": {
    "user_details": {
      "$phoneNumber": {
        ".read": "auth != null || $phoneNumber.length == 10",
        ".write": "auth != null || !data.exists() || (data.exists() && newData.exists())",
        ".validate": "!newData.exists() || (newData.hasChildren(['phone_number', 'password']) && newData.child('phone_number').val().length == 10)",
        "phone_number": {
          ".validate": "newData.isString() && newData.val().length == 10"
        },
        "password": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "Address": {
          ".validate": "newData.isString()"
        },
        "address": {
          ".validate": "newData.isString()"
        }
      }
    },
    "Expenses": {
      "$phoneNumber": {
        ".read": "auth != null || $phoneNumber.length == 10",
        ".write": "auth != null || $phoneNumber.length == 10",
        "$recordKey": {
          ".validate": "!newData.exists() || newData.hasChildren(['Amount', 'Category', 'Date', 'Payment_Mode'])",
          "Amount": {
            ".validate": "newData.isString()"
          },
          "Category": {
            ".validate": "newData.isString()"
          },
          "Date": {
            ".validate": "newData.isString()"
          },
          "Payment_Mode": {
            ".validate": "newData.isString()"
          }
        }
      }
    },
    "Friends": {
      "$phoneNumber": {
        ".read": "auth != null || $phoneNumber.length == 10",
        ".write": "auth != null || $phoneNumber.length == 10",
        "$friendNumber": {
          "friend_name": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "friend_number": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "total_get": {
            ".validate": "newData.isString()"
          },
          "total_give": {
            ".validate": "newData.isString()"
          },
          "Records": {
            "$recordKey": {
              ".validate": "!newData.exists() || newData.hasChildren(['Amount', 'Type', 'Date'])"
            }
          }
        }
      }
    },
    "userUpdates": {
      "$phoneNumber": {
        ".read": "auth != null || $phoneNumber.length == 10",
        ".write": "auth != null || $phoneNumber.length == 10"
      }
    }
  }
}
